# Copy to .env.local and fill in. .env.local is git-ignored.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only "sandbox" is accepted; Nightshift refuses to start with PAYPAL_ENV=live.
PAYPAL_ENV=sandbox
# Optional: the id of an existing webhook. Leave empty and set PUBLIC_BASE_URL to let Nightshift create one.
PAYPAL_WEBHOOK_ID=
# Public https URL of this app (needed for PayPal webhooks and Telegram), e.g. https://nightshift.onrender.com
PUBLIC_BASE_URL=

# LLM via any OpenAI-compatible endpoint. Without LLM_API_KEY, triage is rule-based (clearly labelled).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# Comma-separated extra models the server will accept (LLM_MODEL is always allowed).
LLM_ALLOWED_MODELS=
LLM_MAX_TOKENS=1500

# AG Studio licence key (optional; without it Studio runs with a trial watermark on non-localhost hosts)
AG_STUDIO=

# Telegram approvals (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Public demo mode: scenario lab enabled, per-IP rate limits on AI and lab routes
DEMO_MODE=true

# Optional owner passcode. When set, approvals, settings, fulfilment, the lab and manual sweeps
# need it (unlock in Settings). Leave empty for an open sandbox demo.
OWNER_PASSCODE=

# Scenario lab payments. auto: card orders first; if the sandbox app has no card processing
# (422 PAYEE_NOT_ENABLED_FOR_CARD_PROCESSING), PayPal checkout orders approved by a sandbox buyer.
LAB_PAYMENT_SOURCE=auto
# How the sandbox buyer approves: auto (headless guest checkout if playwright-core and Chromium are
# installed, else manual), headless, or manual (open the link shown in the lab).
LAB_BUYER_APPROVAL=auto
# Optional Chromium binary for the headless buyer (default: the one `npx playwright-core install chromium` downloads)
LAB_CHROMIUM_PATH=
LAB_APPROVAL_TIMEOUT_SECONDS=600

# Storage and worker
DATABASE_PATH=data/nightshift.db
# inline (worker runs inside the web server), external (run `npm run worker` separately), off
WORKER_MODE=inline
# Bearer token for POST /api/sweep from a cron job (optional)
CRON_SECRET=
# Bearer token for POST /api/ingest/orders from your shop (optional; disabled when empty)
INGEST_TOKEN=
